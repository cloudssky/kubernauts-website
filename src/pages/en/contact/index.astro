---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FamilyWordmark from '../../../components/FamilyWordmark.astro';
import SiteNavigation from '../../../components/SiteNavigation.astro';
import CorporateFooter from '../../../components/CorporateFooter.astro';
import AnnouncementBar from '../../../components/AnnouncementBar.astro';
const t={"heading":"Talk to our Kubernetes experts.","sub":"From architecture and platform engineering to Kubernetes operations and AI infrastructure: let's plan your next step together.","details":"DIRECT CONTACT","address":"OUR OFFICE","meeting":"Discuss your Kubernetes project","meetingText":"Book a no-obligation 30-minute introductory conversation with our Kubernetes and platform engineering experts.","features":["30 minutes","Online via Zoom","No obligation"],"cta":"Schedule a project conversation","calendly":"Booking takes place through Calendly in a new browser tab.","community":"KUBERNAUTS COMMUNITY","communityHead":"Kubernauts Worldwide Meetup","communityText":"Share open-source expertise, discuss practical engineering challenges, and connect with the cloud-native community.","communityLink":"Explore the community","email":"Or reach us directly by email.","back":"Homepage","nav":["Services","Industries","Platforms","Approach"],"contact":"Contact","note":"Personal. Technical. No obligation."};
const lang='en';
const navIds=["services","industries","platforms","approach"];
---
<BaseLayout lang={lang} title={`${t.contact} | Kubernauts GmbH`} description={t.sub} canonicalPath="/en/contact/">
  <AnnouncementBar lang={lang}/>
  <header class="site-header">
    <div class="header wrap">
      <a class="logo brand-logo" href="/en/" aria-label="Kubernauts">
        <img src="/brand/kubernauts-hexagon-light.svg" alt="" width="44" height="44"/>
        <span class="brand-type"><FamilyWordmark name="kubernauts" theme="dark" /></span>
      </a>
      <SiteNavigation lang="en" />
      <div class="header-right"><a class="lang" lang="de" href="/de/contact/">DE</a><a class="btn outline" href="/en/contact/" aria-current="page">{t.contact} ↗</a></div>
    </div>
  </header>
  <main class="contact-page">
    <section class="contact-page__hero">
      <div class="wrap contact-page__intro">
        <div>
          <p class="eyebrow">LET'S TALK ENGINEERING</p>
          <h1>{t.heading}</h1>
          <p>{t.sub}</p>
        </div>
        <div class="contact-page__badge"><span aria-hidden="true">✳</span> PLATFORM ENGINEERING · KUBERNETES · AI</div>
      </div>
    </section>
    <section class="wrap contact-page__grid" aria-label={t.contact}>
      <div class="contact-page__primary">
        <div class="contact-page__direct">
          <p class="contact-page__overline">{t.details}</p>
          <h2>Kubernauts GmbH</h2>
          <div class="contact-page__direct-grid">
            <div><span>{t.address}</span><address>Im Mediapark 4C<br/>50670 Köln<br/>Deutschland</address></div>
            <div><span>{t.contact}</span><a href="tel:+4922137990680">+49 221 379 90 680</a><a href="mailto:support@kubernauts.de">support@kubernauts.de</a></div>
          </div>
        </div>
        <article class="contact-booking">
          <div class="contact-booking__top"><span>01 / PROJECT DISCOVERY</span><span aria-hidden="true">↗</span></div>
          <h2>{t.meeting}</h2>
          <p>{t.meetingText}</p>
          <div class="contact-booking__features">{t.features.map(feature=><span>{feature}</span>)}</div>
          <a class="contact-booking__button" href="https://calendly.com/kubernauts/30min" target="_blank" rel="noopener noreferrer">{t.cta} <span aria-hidden="true">↗</span></a>
          <p class="contact-booking__note">{t.calendly}</p>
        </article>
      </div>
      <aside class="contact-page__side">
        <div class="contact-page__side-label">{t.community}</div>
        <h2>{t.communityHead}</h2>
        <p>{t.communityText}</p>
        <a href="https://www.meetup.com/kubernauts/" target="_blank" rel="noopener noreferrer">{t.communityLink} ↗</a>
        <div class="contact-page__side-foot"><p>{t.email}</p><a href="mailto:support@kubernauts.de">support@kubernauts.de ↗</a></div>
      </aside>
    </section>
  </main>
  <CorporateFooter lang={lang}/>
</BaseLayout>
