---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import AnnouncementBar from '../../../../components/AnnouncementBar.astro';
import SiteNavigation from '../../../../components/SiteNavigation.astro';
import CorporateFooter from '../../../../components/CorporateFooter.astro';
import OpenKubesFoundationDetail from '../../../../components/OpenKubesFoundationDetail.astro';
const lang='en';
const contact='Contact';
const other='DE';
---
<BaseLayout lang={lang} title="Sovereign Platform Engineering | OpenKubes | Kubernauts" description="Sovereign Kubernetes platform architecture with contracts, evidence, security and human governance." canonicalPath="/en/openkubes/sovereign-platform/">
 <AnnouncementBar lang={lang}/>
 <header class="site-header"><div class="header wrap">
  <a class="logo brand-logo" href="/en/" aria-label="Kubernauts"><img src="/brand/kubernauts-hexagon-light.svg" alt="" width="44" height="44"/><span class="brand-type"><span class="brand-kuber">KUBER</span><span class="brand-nauts"><span>N</span><span>A</span><span>U</span><span>T</span><span>S</span></span></span></a>
  <SiteNavigation lang={lang}/>
  <div class="header-right"><a class="lang" lang="de" href="/de/openkubes/sovereign-platform/"">{other}</a><a class="btn outline" href="/en/contact/">{contact} ↗</a></div>
 </div></header>
 <OpenKubesOverview lang={lang}/>
 <CorporateFooter lang={lang}/>
</BaseLayout>
