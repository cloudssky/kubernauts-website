---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CorporateFooter from '../../../components/CorporateFooter.astro';
import FamilyWordmark from '../../../components/FamilyWordmark.astro';
const t = {"title":"Legal Notice | Kubernauts GmbH","heading":"Legal Notice","subtitle":"Company information pursuant to Section 5 DDG (Germany)","company":"Provider","represented":"Represented by","registry":"Commercial register","contact":"Contact","tax":"Tax details","taxBody":"The VAT identification number must be verified against the company's records and added before production release.","note":"Relaunch draft – all statutory details require final review before publication.","back":"Back to homepage","privacy":"Privacy policy"};
---
<BaseLayout lang="en" title={t.title} description={t.heading} canonicalPath="/en/imprint/">
  <header class="legal-header"><div class="wrap"><a href="/en/" class="legal-back">← {t.back}</a><a class="legal-home" href="/en/"><img src="/brand/kubernauts-hexagon-light.svg" alt="" width="38" height="38"/><FamilyWordmark name="kubernauts" theme="light" /></a></div></header>
  <main class="legal-page">
    <div class="wrap legal-page__inner">
      <p class="eyebrow">KUBERNAUTS GMBH</p>
      <h1>{t.heading}</h1>
      <p class="legal-lead">{t.subtitle}</p>
      <div class="legal-card">
        <h2>{t.company}</h2>
        <address>Kubernauts GmbH<br/>Im Mediapark 4C<br/>50670 Köln<br/>Deutschland</address>
        <h2>{t.represented}</h2>
        <p>Arash Kaffamanesh</p>
        <h2>{t.registry}</h2>
        <p>Amtsgericht Köln · HRB 94032</p>
        <h2>{t.contact}</h2>
        <p><a href="mailto:contact@kubernauts.de">contact@kubernauts.de</a><br/><a href="tel:+4922137990680">+49 221 379 90 680</a></p>
        <h2>{t.tax}</h2>
        <p>VAT identification number: <strong>DE318037522</strong><br/>German tax number: <strong>215/5825/3036</strong></p>
      </div>
      <p class="legal-draft">{t.note}</p>
      <a class="legal-privacy" href="/en/privacy/">{t.privacy} ↗</a>
    </div>
  </main>
  <CorporateFooter lang="en"/>
</BaseLayout>
