---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import AnnouncementBar from '../../../../components/AnnouncementBar.astro';
import SiteNavigation from '../../../../components/SiteNavigation.astro';
import CorporateFooter from '../../../../components/CorporateFooter.astro';
import OpenKubesProductDetail from '../../../../components/OpenKubesProductDetail.astro';
const lang='en';
---
<BaseLayout lang={lang} title="OpenKubes Bare Metal | Kubernauts" description="OpenKubes bare metal, Kubernetes, KubeVirt, Cluster API, Crossplane and GPU infrastructure." canonicalPath="/en/products/bare-metal/">
 <AnnouncementBar lang={lang}/>
 <header class="site-header"><div class="header wrap">
  <a class="logo brand-logo" href="/en/" aria-label="Kubernauts"><img src="/brand/kubernauts-hexagon-light.svg" alt="" width="44" height="44"/><span class="brand-type"><span class="brand-kuber">KUBER</span><span class="brand-nauts"><span>N</span><span>A</span><span>U</span><span>T</span><span>S</span></span></span></a>
  <SiteNavigation lang={lang}/>
  <div class="header-right"><a class="lang" lang="de" href="/de/products/bare-metal/">DE</a><a class="btn outline" href="/en/contact/">Contact ↗</a></div>
 </div></header>
 <OpenKubesProductDetail lang={lang} product="bare-metal"/>
 <CorporateFooter lang={lang}/>
</BaseLayout>
