---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FamilyWordmark from '../../../components/FamilyWordmark.astro';
import AnnouncementBar from '../../../components/AnnouncementBar.astro';
import SiteNavigation from '../../../components/SiteNavigation.astro';
import CorporateFooter from '../../../components/CorporateFooter.astro';
import ProductsOverview from '../../../components/ProductsOverview.astro';
const lang='en';
const contact='Contact';
const other='DE';
---
<BaseLayout lang={lang} title="Products & Platforms | OpenKubes & Kubernautic | Kubernauts" description="OpenKubes platform framework, Kubernautic agentic AI, bare metal, robotics, private AI, security and industrial edge." canonicalPath="/en/products/">
 <AnnouncementBar lang={lang}/>
 <header class="site-header"><div class="header wrap">
  <a class="logo brand-logo" href="/en/" aria-label="Kubernauts"><img src="/brand/kubernauts-hexagon-light.svg" alt="" width="44" height="44"/><span class="brand-type"><FamilyWordmark name="kubernauts" theme="dark" /></span></a>
  <SiteNavigation lang={lang}/>
  <div class="header-right"><a class="lang" lang="de" href="/de/products/">{other}</a><a class="btn outline" href="/en/contact/">{contact} ↗</a></div>
 </div></header>
 <ProductsOverview lang={lang}/>
 <CorporateFooter lang={lang}/>
</BaseLayout>
