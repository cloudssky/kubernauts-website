---
import BaseLayout from '../../layouts/BaseLayout.astro';
const t = {"lang":"en","other":"DE","otherPath":"/de/","nav":[["Services","#services"],["Industries","#industries"],["Platforms","#platforms"],["Approach","#approach"]],"contact":"Contact","eyebrow":"ENTERPRISE CLOUD NATIVE ENGINEERING","hero":["We Engineer.","We Operate.","We Innovate."],"lead":"Enterprise Kubernetes, sovereign platforms and AI-native infrastructure.","sub":"From architecture and platform engineering to secure operations for mission-critical environments.","explore":"Explore our services","talk":"Talk to our engineers","micro":"BUILT FOR COMPLEXITY. ENGINEERED FOR TRUST.","ticker":"BUILT ON OPEN FOUNDATIONS","servicesEyebrow":"01 / OUR EXPERTISE","servicesTitle":["Engineering for","what comes next."],"servicesIntro":"Modern platform architecture meets hands-on engineering and operational experience.","services":[["Platform Engineering","Design, build and automate Kubernetes platforms across cloud, on-premises and edge."],["Enterprise Kubernetes Operations","Observability, reliability and managed Kubernetes operations for complex environments."],["AI & MLOps","Sovereign AI infrastructure and production-oriented workflows for responsible AI."],["Cloud Native Transformation","Modernization, GitOps and security by design for scalable applications."]],"industriesEyebrow":"02 / MISSION-CRITICAL ENVIRONMENTS","industriesTitle":["Built for environments","where reliability matters."],"industriesDesc":"Cloud-native technology matters when it performs reliably in production — from manufacturing and logistics to regulated enterprises.","industries":["Automotive","Manufacturing","Logistics","Financial Services","Healthcare","Energy"],"platformEyebrow":"03 / INNOVATION & PLATFORMS","platformTitle":["Open innovation.","Real engineering."],"openkubes":"Open, extensible Kubernetes platform architecture — sovereign and declarative by design.","kubernautic":"AI-assisted Kubernetes operational intelligence, with evidence-based analysis and human control.","platformLinks":["Explore OpenKubes","Explore Kubernautic"],"approachEyebrow":"04 / HOW WE WORK","approachTitle":["From architecture","to operations."],"steps":["Assess","Architect","Build","Operate","Evolve"],"contactEyebrow":"LET'S BUILD WHAT'S NEXT","contactTitle":["Ready to build","what comes next?"],"contactCta":"Talk to us","footer":"Concept preview · Not the production website","title":"Kubernauts | Enterprise Kubernetes & Platform Engineering","description":"Enterprise Kubernetes operations, platform engineering, cloud-native modernization and sovereign AI infrastructure."};
const numbers = ['01','02','03','04'];
---
<BaseLayout lang="en" title={t.title} description={t.description}>
<header class="header wrap"><a class="logo brand-logo" href="/en/" aria-label="Kubernauts"><img src="/brand/kubernauts-hexagon.svg" alt="" width="44" height="44" /><span class="brand-type">KUBER<span class="brand-colors"><span>N</span><span>A</span><span>U</span><span>T</span><span>S</span></span></span></a><nav class="navigation" aria-label="Main navigation">{t.nav.map(([name,url])=><a href={url}>{name}</a>)}</nav><div class="header-right"><a class="lang" lang="de" href={t.otherPath}>{t.other}</a><a class="btn outline" href="mailto:contact@kubernauts.de">{t.contact} ↗</a></div></header>
<main>
<section class="hero"><div class="wrap hero-inner"><div class="hero-copy"><p class="eyebrow">● &nbsp;{t.eyebrow}</p><h1>{t.hero[0]}<br />{t.hero[1]}<br /><em>{t.hero[2]}</em></h1><p class="lead">{t.lead}</p><p class="sublead">{t.sub}</p><div class="buttons"><a class="btn primary" href="#services">{t.explore} ↗</a><a class="btn outline" href="mailto:contact@kubernauts.de">{t.talk} ↗</a></div><p class="minor">{t.micro}</p></div><div class="hero-visual" aria-hidden="true"><div class="orbit"></div><div class="orbit"></div><div class="orbit"></div><div class="core"><b>KN</b><small>PLATFORM · OPERATIONS · AI</small></div><span class="sat a">KUBERNETES · ●</span><span class="sat b">GITOPS · ●</span><span class="sat c">OBSERVABILITY · ●</span><span class="sat d">SOVEREIGN AI · ●</span></div></div></section>
<div class="ticker"><div class="wrap"><span>{t.ticker}</span><b>KUBERNETES</b><b>OPEN SOURCE</b><b>GITOPS</b><b>PLATFORM ENGINEERING</b></div></div>
<section id="services" class="section light"><div class="wrap"><div class="section-title"><div><p class="eyebrow">{t.servicesEyebrow}</p><h2>{t.servicesTitle[0]}<br /><em>{t.servicesTitle[1]}</em></h2></div><p>{t.servicesIntro}</p></div><div class="cards">{t.services.map(([title,desc],i)=><article class="card"><span class="number">{numbers[i]} / EXPERTISE</span><h3>{title}</h3><p>{desc}</p><span aria-hidden="true" class="arrow">↗</span></article>)}</div></div></section>
<section id="industries" class="section dark"><div class="wrap split"><div><p class="eyebrow">{t.industriesEyebrow}</p><h2>{t.industriesTitle[0]}<br /><em>{t.industriesTitle[1]}</em></h2></div><div><p class="muted">{t.industriesDesc}</p><div class="chips">{t.industries.map(i=><span>{i}</span>)}</div></div></div></section>
<section id="platforms" class="section light"><div class="wrap"><p class="eyebrow">{t.platformEyebrow}</p><h2>{t.platformTitle[0]}<br /><em>{t.platformTitle[1]}</em></h2><div class="platforms"><article class="platform"><span class="symbol" aria-hidden="true">⬡</span><p class="eyebrow">SOVEREIGN PLATFORM</p><h3>OpenKubes</h3><p>{t.openkubes}</p><a href="https://openkubes.org" target="_blank" rel="noopener noreferrer">{t.platformLinks[0]} ↗</a></article><article class="platform purple"><span class="symbol" aria-hidden="true">✳</span><p class="eyebrow">AGENTIC AI OPERATIONS</p><h3>Kubernautic</h3><p>{t.kubernautic}</p><a href="https://kubernautic.com" target="_blank" rel="noopener noreferrer">{t.platformLinks[1]} ↗</a></article></div></div></section>
<section id="approach" class="section dark"><div class="wrap"><p class="eyebrow">{t.approachEyebrow}</p><h2>{t.approachTitle[0]}<br /><em>{t.approachTitle[1]}</em></h2><div class="steps">{t.steps.map((step,i)=><span>{'0'+(i+1)} <strong>{step}</strong></span>)}</div></div></section>
<section class="section contact"><div class="wrap"><p class="eyebrow">{t.contactEyebrow}</p><h2>{t.contactTitle[0]}<br /><em>{t.contactTitle[1]}</em></h2><a class="btn primary" href="mailto:contact@kubernauts.de">{t.contactCta} ↗</a></div></section>
</main>
<footer><div class="wrap footer-inner"><a class="logo brand-logo" href="/en/" aria-label="Kubernauts"><img src="/brand/kubernauts-hexagon.svg" alt="" width="44" height="44" /><span class="brand-type">KUBER<span class="brand-colors"><span>N</span><span>A</span><span>U</span><span>T</span><span>S</span></span></span></a><span>© {new Date().getFullYear()} Kubernauts · {t.footer}</span><a href={t.otherPath} lang="de">{t.other}</a></div></footer>
</BaseLayout>
