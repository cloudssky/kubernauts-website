---
<BaseLayout lang="en" title={t.title} description={t.description}>
<AnnouncementBar lang="en" />
<header class="site-header"><div class="header wrap"><a class="logo brand-logo" href="/en/" aria-label="Kubernauts"><img src="/brand/kubernauts-hexagon-light.svg" alt="" width="44" height="44" /><span class="brand-type"><FamilyWordmark name="kubernauts" theme="dark" /></span></a><SiteNavigation lang="en" /><div class="header-right"><a class="lang" lang="de" href={t.otherPath}>{t.other}</a><a class="btn outline" href="/en/contact/">{t.contact} ↗</a></div></div></header>
<main>
<section class="hero"><div class="wrap hero-inner"><div class="hero-copy"><p class="eyebrow">● &nbsp;{t.eyebrow}</p><h1>{t.hero[0]}<br />{t.hero[1]}<br /><em>{t.hero[2]}</em></h1><p class="lead">Enterprise Kubernetes, sovereign platforms and<br class="hero-desktop-break" /> AI-native infrastructure.</p><p class="sublead">From architecture and platform engineering to secure operations<br class="hero-desktop-break" /> for mission-critical environments.</p><div class="buttons"><a class="btn primary" href="#services">{t.explore} ↗</a><a class="btn outline" href="/en/contact/">{t.talk} ↗</a></div><p class="minor">{t.micro}</p></div><PlatformDiagram lang="en" /></div></section>
<div class="ticker"><div class="wrap"><span>{t.ticker}</span><b>KUBERNETES</b><b>OPEN SOURCE</b><b>GITOPS</b><b>PLATFORM ENGINEERING</b></div></div>
<section id="services" class="section light"><div class="wrap"><div class="section-title"><div><p class="eyebrow">{t.servicesEyebrow}</p><h2>{t.servicesTitle[0]}<br /><em>{t.servicesTitle[1]}</em></h2></div><p>{t.servicesIntro}</p></div><ServicesGrid lang="en" items={serviceItems} /></div></section>
<section id="industries" class="section dark industries-section"><div class="wrap"><div class="industries-intro"><div><p class="eyebrow">{t.industriesEyebrow}</p><h2>{t.industriesTitle[0]}<br /><em>{t.industriesTitle[1]}</em></h2></div><p class="muted">Architecture and operations for demanding environments — where security, reliability and technical integration converge.</p></div><IndustriesGrid lang="en" industries={industryItems}/></div></section>
<section id="platforms" class="section light innovation-section"><div class="wrap"><p class="eyebrow">{t.platformEyebrow}</p><h2>{t.platformTitle[0]}<br /><em>{t.platformTitle[1]}</em></h2><InnovationPlatforms lang="en"/></div></section>
<section id="approach" class="section dark approach-section"><div class="wrap"><p class="eyebrow">{t.approachEyebrow}</p><h2>{t.approachTitle[0]}<br /><em>{t.approachTitle[1]}</em></h2><EngineeringApproach lang="en" /></div></section>
<ContactSection lang="en" />
</main>
<CorporateFooter lang="en" />
</BaseLayout>
