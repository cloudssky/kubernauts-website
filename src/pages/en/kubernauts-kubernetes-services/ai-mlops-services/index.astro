---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import FamilyWordmark from '../../../../components/FamilyWordmark.astro';
import AnnouncementBar from '../../../../components/AnnouncementBar.astro';
import SiteNavigation from '../../../../components/SiteNavigation.astro';
import CorporateFooter from '../../../../components/CorporateFooter.astro';
import AiMlopsLanding from '../../../../components/AiMlopsLanding.astro';
const lang='en';
const nav=[["Services","services"],["Industries","industries"],["Platforms","platforms"],["Approach","approach"]];
const contact='Contact';
const other='DE';
---
<BaseLayout lang={lang}
 title="AI & MLOps Services | Private AI & GPU Platforms | Kubernauts"
 description="AI & MLOps: Private AI, Kubernetes GPU infrastructure, MLOps pipelines, AI governance, edge AI and model operations."
 canonicalPath="/en/kubernauts-kubernetes-services/ai-mlops-services/">
 <AnnouncementBar lang={lang}/>
 <header class="site-header"><div class="header wrap">
  <a class="logo brand-logo" href="/en/" aria-label="Kubernauts"><img src="/brand/kubernauts-hexagon-light.svg" alt="" width="44" height="44"/><span class="brand-type"><FamilyWordmark name="kubernauts" theme="dark" /></span></a>
  <SiteNavigation lang="en" />
  <div class="header-right"><a class="lang" lang="de" href="/de/kubernauts-kubernetes-services/ai-mlops-services/">{other.toUpperCase()}</a><a class="btn outline" href="/en/contact/">{contact} ↗</a></div>
 </div></header>
 <AiMlopsLanding lang={lang}/>
 <CorporateFooter lang={lang}/>
</BaseLayout>
