---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import AnnouncementBar from '../../../../components/AnnouncementBar.astro';
import SiteNavigation from '../../../../components/SiteNavigation.astro';
import CorporateFooter from '../../../../components/CorporateFooter.astro';
import PlatformEngineeringLanding from '../../../../components/PlatformEngineeringLanding.astro';
const lang='en';
const nav=[["Services","services"],["Industries","industries"],["Platforms","platforms"],["Approach","approach"]];
const contact='Contact';
const other='DE';
---
<BaseLayout lang={lang}
 title="Platform Engineering | Kubernetes Platforms | Kubernauts"
 description="Platform engineering services: Kubernetes architecture, GitOps, networking, security, storage, multi-cluster and observability."
 canonicalPath="/en/kubernauts-kubernetes-services/platform-engineering/">
 <AnnouncementBar lang={lang}/>
 <header class="site-header"><div class="header wrap">
  <a class="logo brand-logo" href="/en/" aria-label="Kubernauts"><img src="/brand/kubernauts-hexagon-light.svg" alt="" width="44" height="44"/><span class="brand-type"><span class="brand-kuber">KUBER</span><span class="brand-nauts"><span>N</span><span>A</span><span>U</span><span>T</span><span>S</span></span></span></a>
  <SiteNavigation lang="en" />
  <div class="header-right"><a class="lang" lang="de" href="/de/kubernauts-kubernetes-services/platform-engineering/">{other.toUpperCase()}</a><a class="btn outline" href="/en/contact/">{contact} ↗</a></div>
 </div></header>
 <PlatformEngineeringLanding lang={lang}/>
 <CorporateFooter lang={lang}/>
</BaseLayout>
