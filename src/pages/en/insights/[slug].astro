---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FamilyWordmark from '../../../components/FamilyWordmark.astro';
import AnnouncementBar from '../../../components/AnnouncementBar.astro';
import SiteNavigation from '../../../components/SiteNavigation.astro';
import CorporateFooter from '../../../components/CorporateFooter.astro';
import InsightArticle from '../../../components/InsightArticle.astro';
import {insights, insightBySlug} from '../../../data/insights';
export function getStaticPaths(){return insights.map(item=>({params:{slug:item.slug}}));}
const {slug}=Astro.params;
const insight=insightBySlug(slug!);
const lang='en';
---
<BaseLayout lang={lang} title={insight!.title[lang]+' | Engineering Insights | Kubernauts'} description={insight!.subtitle[lang]} canonicalPath={'/${lang}/insights/'+slug+'/'}>
<AnnouncementBar lang={lang}/>
<header class="site-header"><div class="header wrap"><a class="logo brand-logo" href="/en/" aria-label="Kubernauts"><img src="/brand/kubernauts-hexagon-light.svg" alt="" width="44" height="44"/><span class="brand-type"><FamilyWordmark name="kubernauts" theme="dark"/></span></a><SiteNavigation lang={lang}/><div class="header-right"><a class="lang" lang="de" href={'/${lang==="de"?"en":"de"}/insights/'+slug+'/'}>DE</a><a class="btn outline" href="/en/contact/">Contact ↗</a></div></div></header>
<InsightArticle lang={lang} slug={slug!}/>
<CorporateFooter lang={lang}/>
</BaseLayout>