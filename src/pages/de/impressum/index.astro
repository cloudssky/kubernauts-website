---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CorporateFooter from '../../../components/CorporateFooter.astro';
const t = {"title":"Impressum | Kubernauts GmbH","heading":"Impressum","subtitle":"Angaben gemäß § 5 DDG","company":"Anbieter","represented":"Vertreten durch","registry":"Handelsregister","contact":"Kontakt","tax":"Steuerliche Angaben","taxBody":"Die Umsatzsteuer-Identifikationsnummer muss vor Veröffentlichung anhand der aktuellen Unternehmensunterlagen ergänzt und geprüft werden.","note":"Entwurf für den Relaunch – rechtliche Pflichtangaben vor Produktivschaltung abschließend prüfen.","back":"Zurück zur Startseite","privacy":"Datenschutzerklärung"};
---
<BaseLayout lang="de" title={t.title} description={t.heading} canonicalPath="/de/impressum/">
  <header class="legal-header"><div class="wrap"><a href="/de/" class="legal-back">← {t.back}</a><a class="legal-home" href="/de/"><img src="/brand/kubernauts-hexagon-light.svg" alt="" width="38" height="38"/>KUBERNAUTS</a></div></header>
  <main class="legal-page">
    <div class="wrap legal-page__inner">
      <p class="eyebrow">KUBERNAUTS GMBH</p>
      <h1>{t.heading}</h1>
      <p class="legal-lead">{t.subtitle}</p>
      <div class="legal-card">
        <h2>{t.company}</h2>
        <address>Kubernauts GmbH<br/>Im Mediapark 4C<br/>50670 Köln<br/>Deutschland</address>
        <h2>{t.represented}</h2>
        <p>Arash Kaffamanesh</p>
        <h2>{t.registry}</h2>
        <p>Amtsgericht Köln · HRB 94032</p>
        <h2>{t.contact}</h2>
        <p><a href="mailto:contact@kubernauts.de">contact@kubernauts.de</a><br/><a href="tel:+4922137990680">+49 221 379 90 680</a></p>
        <h2>{t.tax}</h2>
        <p class="legal-pending">{t.taxBody}</p>
      </div>
      <p class="legal-draft">{t.note}</p>
      <a class="legal-privacy" href="/de/datenschutz/">{t.privacy} ↗</a>
    </div>
  </main>
  <CorporateFooter lang="de"/>
</BaseLayout>
