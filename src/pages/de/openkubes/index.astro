---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FamilyWordmark from '../../components/FamilyWordmark.astro';
import AnnouncementBar from '../../../components/AnnouncementBar.astro';
import SiteNavigation from '../../../components/SiteNavigation.astro';
import CorporateFooter from '../../../components/CorporateFooter.astro';
import OpenKubesOverview from '../../../components/OpenKubesOverview.astro';
const lang='de';
const contact='Kontakt';
const other='EN';
---
<BaseLayout lang={lang} title="OpenKubes | Souveränes Kubernetes Platform Framework | Kubernauts" description="OpenKubes: offenes Kubernetes Platform Distribution Framework, Contracts First, souveräne Infrastruktur, Bare Metal, Industrial Edge und Private AI." canonicalPath="/de/openkubes/">
 <AnnouncementBar lang={lang}/>
 <header class="site-header"><div class="header wrap">
  <a class="logo brand-logo" href="/de/" aria-label="Kubernauts"><img src="/brand/kubernauts-hexagon-light.svg" alt="" width="44" height="44"/><span class="brand-type"><FamilyWordmark name="kubernauts" theme="dark" /></span></a>
  <SiteNavigation lang={lang}/>
  <div class="header-right"><a class="lang" lang="en" href="/en/openkubes/">{other}</a><a class="btn outline" href="/de/contact/">{contact} ↗</a></div>
 </div></header>
 <OpenKubesOverview lang={lang}/>
 <CorporateFooter lang={lang}/>
</BaseLayout>
