---
<BaseLayout lang="de" title={t.title} description={t.description}>
<AnnouncementBar lang="de" />
<header class="site-header"><div class="header wrap"><a class="logo brand-logo" href="/de/" aria-label="Kubernauts"><img src="/brand/kubernauts-hexagon-light.svg" alt="" width="44" height="44" /><span class="brand-type"><span class="brand-kuber">KUBER</span><span class="brand-nauts"><span>N</span><span>A</span><span>U</span><span>T</span><span>S</span></span></span></a><SiteNavigation lang="de" /><div class="header-right"><a class="lang" lang="en" href={t.otherPath}>{t.other}</a><a class="btn outline" href="/de/contact/">{t.contact} ↗</a></div></div></header>
<main>
<section class="hero"><div class="wrap hero-inner"><div class="hero-copy"><p class="eyebrow">● &nbsp;{t.eyebrow}</p><h1>{t.hero[0]}<br />{t.hero[1]}<br /><em>{t.hero[2]}</em></h1><p class="lead">{t.lead}</p><p class="sublead">{t.sub}</p><div class="buttons"><a class="btn primary" href="#services">{t.explore} ↗</a><a class="btn outline" href="/de/contact/">{t.talk} ↗</a></div><p class="minor">{t.micro}</p></div><PlatformDiagram lang="de" /></div></section>
<div class="ticker"><div class="wrap"><span>{t.ticker}</span><b>KUBERNETES</b><b>OPEN SOURCE</b><b>GITOPS</b><b>PLATFORM ENGINEERING</b></div></div>
<section id="services" class="section light"><div class="wrap"><div class="section-title"><div><p class="eyebrow">{t.servicesEyebrow}</p><h2>{t.servicesTitle[0]}<br /><em>{t.servicesTitle[1]}</em></h2></div><p>{t.servicesIntro}</p></div><ServicesGrid lang="de" items={serviceItems} /></div></section>
<section id="industries" class="section dark industries-section"><div class="wrap"><div class="industries-intro"><div><p class="eyebrow">{t.industriesEyebrow}</p><h2>{t.industriesTitle[0]}<br /><em>{t.industriesTitle[1]}</em></h2></div><p class="muted">Architektur und Betrieb für anspruchsvolle Umgebungen – wo Sicherheitsanforderungen, Verfügbarkeit und technische Integration zusammenkommen.</p></div><IndustriesGrid lang="de" industries={industryItems}/></div></section>
<section id="platforms" class="section light innovation-section"><div class="wrap"><p class="eyebrow">{t.platformEyebrow}</p><h2>{t.platformTitle[0]}<br /><em>{t.platformTitle[1]}</em></h2><InnovationPlatforms lang="de"/></div></section>
<section id="approach" class="section dark approach-section"><div class="wrap"><p class="eyebrow">{t.approachEyebrow}</p><h2>{t.approachTitle[0]}<br /><em>{t.approachTitle[1]}</em></h2><EngineeringApproach lang="de" /></div></section>
<ContactSection lang="de" />
</main>
<CorporateFooter lang="de" />
</BaseLayout>
