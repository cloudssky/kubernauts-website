---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FamilyWordmark from '../../../components/FamilyWordmark.astro';
import AnnouncementBar from '../../../components/AnnouncementBar.astro';
import SiteNavigation from '../../../components/SiteNavigation.astro';
import CorporateFooter from '../../../components/CorporateFooter.astro';
import IndustryLanding from '../../../components/IndustryLanding.astro';
const lang='de';
---
<BaseLayout lang={lang} title="Industries | Kubernauts" description="Enterprise engineering across manufacturing, finance and distributed systems." canonicalPath="/de/industries/">
<AnnouncementBar lang={lang}/><header class="site-header"><div class="header wrap"><a class="logo brand-logo" href="/de/"><img src="/brand/kubernauts-hexagon-light.svg" width="44" height="44" alt=""/><span class="brand-type"><FamilyWordmark name="kubernauts" theme="dark"/></span></a><SiteNavigation lang={lang}/><div class="header-right"><a class="lang" href="/en/industries/">EN</a><a class="btn outline" href="/de/contact/">Kontakt ↗</a></div></div></header>
<IndustryLanding lang={lang} type="hub"/><CorporateFooter lang={lang}/></BaseLayout>