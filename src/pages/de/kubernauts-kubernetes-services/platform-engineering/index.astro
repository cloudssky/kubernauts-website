---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import AnnouncementBar from '../../../../components/AnnouncementBar.astro';
import SiteNavigation from '../../../../components/SiteNavigation.astro';
import CorporateFooter from '../../../../components/CorporateFooter.astro';
import PlatformEngineeringLanding from '../../../../components/PlatformEngineeringLanding.astro';
const lang='de';
const nav=[["Leistungen","services"],["Branchen","industries"],["Plattformen","platforms"],["Vorgehen","approach"]];
const contact='Kontakt';
const other='EN';
---
<BaseLayout lang={lang}
 title="Platform Engineering | Kubernetes Plattformen | Kubernauts"
 description="Platform Engineering: Kubernetes-Architektur, GitOps, Networking, Security, Storage, Multi-Cluster und Observability."
 canonicalPath="/de/kubernauts-kubernetes-services/platform-engineering/">
 <AnnouncementBar lang={lang}/>
 <header class="site-header"><div class="header wrap">
  <a class="logo brand-logo" href="/de/" aria-label="Kubernauts"><img src="/brand/kubernauts-hexagon-light.svg" alt="" width="44" height="44"/><span class="brand-type"><span class="brand-kuber">KUBER</span><span class="brand-nauts"><span>N</span><span>A</span><span>U</span><span>T</span><span>S</span></span></span></a>
  <SiteNavigation lang="de" />
  <div class="header-right"><a class="lang" lang="en" href="/en/kubernauts-kubernetes-services/platform-engineering/">{other.toUpperCase()}</a><a class="btn outline" href="/de/contact/">{contact} ↗</a></div>
 </div></header>
 <PlatformEngineeringLanding lang={lang}/>
 <CorporateFooter lang={lang}/>
</BaseLayout>
