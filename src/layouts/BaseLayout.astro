---
import '../styles/global.css';
import ConsentManager from '../components/ConsentManager.astro';
interface Props { title: string; description: string; lang: 'de' | 'en'; canonicalPath?: string; }
const { title, description, lang, canonicalPath } = Astro.props;
const site = 'https://kubernauts.de';
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#071421" />
  <meta name="robots" content="noindex,follow" />
  <title>{title}</title>
  <link rel="canonical" href={site + (canonicalPath ?? '/' + lang + '/')} />
  { !canonicalPath && <link rel="alternate" hreflang="de" href={site + '/de/'} /> }
  { !canonicalPath && <link rel="alternate" hreflang="en" href={site + '/en/'} /> }
  { !canonicalPath && <link rel="alternate" hreflang="x-default" href={site + '/de/'} /> }
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
</head>
<body><slot /><ConsentManager lang={lang} /></body>
</html>
