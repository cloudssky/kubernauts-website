---
interface Props { lang: 'de' | 'en'; }
const { lang } = Astro.props;
const de = lang === 'de';
const registrationUrl = 'https://events.linuxfoundation.org/kubecon-cloudnativecon-europe/register/';
---
<aside class="event-announcement" aria-label={de ? 'Veranstaltungshinweis' : 'Event announcement'}>
  <div class="event-announcement__inner wrap">
    <span class="event-announcement__marker" aria-hidden="true">✦</span>
    <p>
      <strong>KubeCon + CloudNativeCon Europe 2027</strong>
      <span class="event-announcement__details">{de ? 'Barcelona · 15.–18. März' : 'Barcelona · 15–18 March'}</span>
      <span class="event-announcement__invite">{de ? 'Besucht uns am OpenKubes Booth!' : 'Visit our OpenKubes booth!'}</span>
    </p>
    <a class="event-announcement__cta" href={registrationUrl} target="_blank" rel="noopener noreferrer">
      {de ? 'Jetzt anmelden' : 'Register now'} <span aria-hidden="true">↗</span>
      <span class="sr-only">{de ? '(öffnet die offizielle Event-Registrierung in neuem Tab)' : '(opens official event registration in a new tab)'}</span>
    </a>
  </div>
</aside>
