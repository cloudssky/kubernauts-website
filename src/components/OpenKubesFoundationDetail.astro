---
interface Props {lang:'de'|'en'; topic:'sovereign-platform'|'openkubes-anywhere'}
const {lang,topic}=Astro.props;
const d={"sovereign-platform":{"de":{"eyebrow":"OPENKUBES · SOVEREIGN PLATFORM","title":"Souveränität beginnt","accent":"bei der Architektur.","lead":"Offene Kubernetes-Plattformen mit überprüfbaren Anforderungen, klarer Verantwortung und austauschbaren Implementierungen.","intro":"Kontrolle über Cloud-Infrastruktur entsteht nicht allein durch die Wahl des Providers. Entscheidend sind Architekturverträge, Identitäten, Zugriff auf die Control Plane, Software-Lieferketten und belegbare Betriebsprozesse.","cards":[["Contracts First","Plattformfähigkeiten und Qualitätskriterien unabhängig von Einzelprodukten definieren."],["Evidence Driven","Cluster-, Security- und Betriebszustände anhand überprüfbarer Nachweise bewerten."],["Human Controlled","Änderungen an Architekturverträgen und Governance nur mit menschlicher Freigabe."],["Provider Independence","Infrastruktur- und Technologieentscheidungen innerhalb klarer Verträge austauschbar halten."],["Security by Design","Identitäten, Policies, Netzwerkgrenzen und Software Supply Chain in die Plattformarchitektur integrieren."],["GitOps & Lifecycle","Konfigurationen und Änderungen versionieren, automatisieren und nachvollziehbar ausrollen."]],"closing":"Souveränität messbar machen.","cta":"Plattformarchitektur besprechen","note":"OpenKubes ist ein offenes Framework; konkrete Implementierungsprofile und Nachweise werden pro Projekt validiert."},"en":{"eyebrow":"OPENKUBES · SOVEREIGN PLATFORM","title":"Sovereignty starts","accent":"in the architecture.","lead":"Open Kubernetes platforms with verifiable requirements, explicit ownership and replaceable implementations.","intro":"Infrastructure control does not come from provider selection alone. Architecture contracts, identity, control-plane access, software supply chains and provable operations are critical.","cards":[["Contracts First","Define capabilities and acceptance criteria independently of specific products."],["Evidence Driven","Validate platform, security and operational states using reviewable evidence."],["Human Controlled","Keep changes to architecture contracts and governance under human approval."],["Provider Independence","Maintain replaceability of infrastructure and technology behind well-defined contracts."],["Security by Design","Integrate identities, policy, network boundaries and supply-chain controls into architecture."],["GitOps & Lifecycle","Version and automate platform configuration and controlled deployments."]],"closing":"Make sovereignty measurable.","cta":"Discuss platform architecture","note":"OpenKubes is an open framework; implementation profiles and evidence must be validated per project."}},"openkubes-anywhere":{"de":{"eyebrow":"OPENKUBES · ANYWHERE","title":"Eine Plattformstrategie.","accent":"Überall einsetzbar.","lead":"Ein konsistentes Kubernetes-Betriebsmodell für lokale Entwicklung, Bare Metal, Cloud und industrielle Edge-Standorte.","intro":"Unterschiedliche Infrastruktur erfordert nicht zwangsläufig unterschiedliche Plattformverträge. OpenKubes Anywhere verbindet deklarative Cluster-Bereitstellung, GitOps und Betriebsstandards über heterogene Umgebungen hinweg.","cards":[["Local & Developer Environments","Reproduzierbare Entwicklungs- und Evaluierungsumgebungen mit definierten Plattformfähigkeiten."],["Bare Metal & Virtualization","Kubernetes, KubeVirt und Cluster-Lifecycle auf kontrollierter Rechenzentrumsinfrastruktur."],["Private & Public Cloud","Provider-spezifische Implementierungen hinter gemeinsamen Plattformanforderungen."],["Industrial Edge","Verteilte Plattformen mit standortabhängigen Netzwerk- und Offline-Eigenschaften."],["GitOps Fleet Operations","Versionierte Konfiguration, abgestufte Rollouts und überprüfbare Zielzustände."],["Observability & Governance","Einheitliche Sicht auf Plattformzustände, Security-Kontrollen und Betriebsnachweise."]],"closing":"OpenKubes dort einsetzen, wo Sie es brauchen.","cta":"Anywhere-Architektur besprechen","note":"Cluster-Provider, Offline-Fähigkeit und Integrationen hängen von der jeweiligen Zielumgebung ab."},"en":{"eyebrow":"OPENKUBES · ANYWHERE","title":"One platform strategy.","accent":"Across environments.","lead":"A consistent Kubernetes operating model for local development, bare metal, cloud and industrial edge sites.","intro":"Different infrastructure should not require different platform contracts. OpenKubes Anywhere combines declarative provisioning, GitOps and operating standards across heterogeneous environments.","cards":[["Local & Developer Environments","Repeatable development and evaluation environments with defined platform capabilities."],["Bare Metal & Virtualization","Kubernetes, KubeVirt and cluster lifecycle on controlled data-center infrastructure."],["Private & Public Cloud","Provider-specific implementations behind shared platform requirements."],["Industrial Edge","Distributed platforms with site-specific networking and offline constraints."],["GitOps Fleet Operations","Versioned configuration, staged releases and verifiable desired state."],["Observability & Governance","A consistent view of operational health, security controls and platform evidence."]],"closing":"Deploy OpenKubes where you need it.","cta":"Discuss an Anywhere architecture","note":"Cluster providers, offline features and integrations depend on each target environment."}}}[topic][lang];
const booking='https://calendly.com/kubernauts/30min';
---
<main class="platform-service ok-detail">
 <section class="platform-service__hero"><div class="wrap platform-service__hero-grid">
  <div><p class="eyebrow">{d.eyebrow}</p><h1>{d.title}<br/><em>{d.accent}</em></h1><p class="platform-service__lead">{d.lead}</p><div class="platform-service__actions"><a class="platform-service__primary" href={booking} target="_blank" rel="noopener noreferrer">{d.cta} ↗</a><a class="platform-service__secondary" href={'/'+lang+'/openkubes/'}>{lang==='de'?'OpenKubes Übersicht':'OpenKubes Overview'} ↗</a></div></div>
  <aside class="platform-service__proof"><div class="platform-service__proof-top"><span>{d.eyebrow}</span><span>⬡</span></div><ul>{d.cards.slice(0,4).map(([name],i)=><li><span>{String(i+1).padStart(2,'0')}</span>{name}</li>)}</ul><span>CONTRACTS · EVIDENCE · HUMAN GOVERNANCE</span></aside>
 </div></section>
 <section class="platform-service__intro"><div class="wrap platform-service__intro-grid"><div><p class="eyebrow">ARCHITECTURE · PLATFORMS</p><h2>{lang==='de'?'Plattformen statt Silos.':'Platforms instead of silos.'}</h2></div><p>{d.intro}</p></div></section>
 <section class="platform-service__skills"><div class="wrap"><p class="eyebrow">OPENKUBES / CAPABILITIES</p><h2>{lang==='de'?'Verträge, Fähigkeiten, Kontrolle.':'Contracts, capabilities, control.'}</h2><div class="platform-service__skills-grid">{d.cards.map(([name,description],i)=><article><span>{String(i+1).padStart(2,'0')} / CAPABILITY</span><h3>{name}</h3><p>{description}</p></article>)}</div><p class="ok-detail__note">{d.note}</p></div></section>
 <section class="platform-service__closing"><div class="wrap"><p class="eyebrow">LET'S TALK ENGINEERING</p><h2>{d.closing}</h2><div class="platform-service__actions"><a class="platform-service__primary" href={booking} target="_blank" rel="noopener noreferrer">{d.cta} ↗</a><a class="platform-service__secondary" href={'/'+lang+'/openkubes/'}>{lang==='de'?'Zur OpenKubes Übersicht':'Back to OpenKubes'} ↗</a></div></div></section>
</main>