---
interface Props { lang:'de'|'en'; onHome?:boolean; }
const {lang,onHome=false}=Astro.props;
const de=lang==='de';
const base='/'+lang+'/';
const items=[
 {label:de?'Platform Engineering':'Platform Engineering',detail:de?'Architektur, GitOps & Automatisierung':'Architecture, GitOps & Automation',url:base+'kubernauts-kubernetes-services/platform-engineering/',icon:'layers'},
 {label:de?'Enterprise Kubernetes Operations':'Enterprise Kubernetes Operations',detail:de?'Managed Kubernetes, SRE & Security':'Managed Kubernetes, SRE & Security',url:base+'kubernauts-kubernetes-services/index.html',icon:'activity'},
 {label:'AI & MLOps',detail:de?'Private AI & Modellbetrieb':'Private AI & Model Operations',url:base+'kubernauts-kubernetes-services/ai-mlops-services/',icon:'brain'},
 {label:'Cloud Native Transformation',detail:de?'Modernisierung, CI/CD & GitOps':'Modernization, CI/CD & GitOps',url:base+'kubernauts-kubernetes-services/cloud-native-transformation/',icon:'refresh'},
 {label:'AI Software Engineering & Integration',detail:de?'Agentic AI · Business Workflows · Enterprise Integration':'Agentic AI · Business Workflows · Enterprise Integration',url:base+'services/enterprise-ai-engineering/',icon:'brain'},
 {label:'Sovereign Agentic AI Operations',detail:de?'AI Diagnostics · Governance · Human Approval':'AI Diagnostics · Governance · Human Approval',url:base+'kubernauts-kubernetes-services/sovereign-agentic-ai-operations/',icon:'brain'}
];
const nav=[
{label:'Insights',href:base+'insights/'},
 {label:de?'Vorgehen':'Approach',href:base+'#approach'},
 {label:de?'Karriere':'Careers',href:base+'careers/'}
];
---
<nav class="navigation main-navigation" aria-label={de?'Hauptnavigation':'Main navigation'}>
  <details class="nav-products">
    <summary>{de?'Produkte':'Products'} <span class="nav-services__chevron" aria-hidden="true">⌄</span></summary>
    <div class="nav-products__menu">
      <a href={base+'products/'} class="nav-products__all">{de?'Alle Produkte & Plattformen':'All products & platforms'} <span aria-hidden="true">↗</span></a>
      <a href={base+'openkubes/'}><strong>OpenKubes</strong><small>{de?'Souveränes Plattformframework':'Sovereign platform framework'}</small></a>
      <a href={base+'kubernautic/'}><strong>Kubernautic</strong><small>Agentic AI Operations</small></a>
      <a href={base+'products/#products-solutions'}><strong>{de?'Spezialisierte Lösungen':'Specialized solutions'}</strong><small>Bare Metal · Robotics · Private AI · Edge</small></a>
      <a href={base+'openkubes/inhouse-ai/'}><strong>OpenKubes Inhouse AI</strong><small>Private LLMs · GPU · RAG</small></a>
      <a href={base+'products/bare-metal/'}><strong>OpenKubes Bare Metal</strong><small>KubeVirt · Cluster API · GPU</small></a>
      <a href={base+'products/robotics/'}><strong>OpenKubes Robotics</strong><small>ROS 2 · Open-RMF · Physical AI</small></a>
      <a href={base+'products/security/'}><strong>OpenKubes Security</strong><small>Zero Trust · Policies · Governance</small></a>
      <a href={base+'openkubes/openkubes-edge/index.html'}><strong>OpenKubes Industrial Edge</strong><small>Distributed Kubernetes · GitOps · Edge AI</small></a>
    </div>
  </details>
  <details class="nav-services">
    <summary>{de?'Leistungen':'Services'} <span class="nav-services__chevron" aria-hidden="true">⌄</span></summary>
    <div class="nav-services__menu">
      <a class="nav-services__all" href={base+'#services'}>{de?'Alle Leistungen':'All services'} <span aria-hidden="true">→</span></a>
      {items.map((item)=><a href={item.url} class="nav-services__item">
        <span class="nav-services__dot" aria-hidden="true"></span>
        <span><strong>{item.label}</strong><small>{item.detail}</small></span>
        <span aria-hidden="true">↗</span>
      </a>)}
    </div>
  </details>
  <details class="nav-industries">
    <summary>{de?'Branchen':'Industries'} <span class="nav-services__chevron" aria-hidden="true">⌄</span></summary>
    <div class="nav-industries__menu">
      <a class="nav-industries__all" href={base+'industries/'}>{de?'Alle Branchen':'All industries'} <span aria-hidden="true">↗</span></a>
      <a href={base+'industries/industrial-manufacturing/'}><strong>{de?'Industrie & Fertigung':'Industrial Manufacturing'}</strong><small>Industrial Kubernetes · OT/IT · Edge AI</small></a>
      <a href={base+'industries/banking-and-insurance/'}><strong>{de?'Banken & Versicherungen':'Banking & Insurance'}</strong><small>Security · Governance · Resilience</small></a>
      <a href={base+'industries/use-cases-and-success-stories/'}><strong>{de?'Anwendungsfälle':'Use Cases'}</strong><small>{de?'Architekturmuster & Szenarien':'Architecture patterns & scenarios'}</small></a>
    </div>
  </details>
  {nav.map(item=><a href={item.href}>{item.label}</a>)}
</nav>
<details class="mobile-menu">
  <summary aria-label={de?'Menü öffnen':'Open menu'}><span class="hamburger" aria-hidden="true">☰</span><span>{de?'Menü':'Menu'}</span></summary>
  <nav class="mobile-menu-panel" aria-label={de?'Mobile Navigation':'Mobile navigation'}>
    <details class="mobile-services">
      <summary>{de?'Produkte':'Products'} <span aria-hidden="true">⌄</span></summary>
      <div class="mobile-services__links">
        <a href={base+'products/'}>{de?'Alle Produkte':'All products'}</a>
        <a href={base+'openkubes/'}>OpenKubes</a>
        <a href={base+'kubernautic/'}>Kubernautic ↗</a>
        <a href={base+'products/#products-solutions'}>{de?'Spezialisierte Lösungen':'Specialized solutions'}</a>
        <a href={base+'openkubes/inhouse-ai/'}>OpenKubes Inhouse AI</a>
        <a href={base+'products/bare-metal/'}>OpenKubes Bare Metal</a>
        <a href={base+'products/robotics/'}>OpenKubes Robotics</a>
        <a href={base+'products/security/'}>OpenKubes Security</a>
        <a href={base+'openkubes/openkubes-edge/index.html'}>OpenKubes Industrial Edge</a>
      </div>
    </details>
    <details class="mobile-services">
      <summary>{de?'Leistungen':'Services'} <span aria-hidden="true">⌄</span></summary>
      <div class="mobile-services__links">
        <a href={base+'#services'}>{de?'Alle Leistungen':'All services'}</a>
        {items.map(item=><a href={item.url}>{item.label}</a>)}
      </div>
    </details>
    <details class="mobile-services">
      <summary>{de?'Branchen':'Industries'} <span aria-hidden="true">⌄</span></summary>
      <div class="mobile-services__links">
        <a href={base+'industries/'}>{de?'Alle Branchen':'All industries'}</a>
        <a href={base+'industries/industrial-manufacturing/'}>{de?'Industrie & Fertigung':'Industrial Manufacturing'}</a>
        <a href={base+'industries/banking-and-insurance/'}>{de?'Banken & Versicherungen':'Banking & Insurance'}</a>
        <a href={base+'industries/use-cases-and-success-stories/'}>{de?'Anwendungsfälle':'Use Cases'}</a>
      </div>
    </details>
    {nav.map(item=><a href={item.href}>{item.label}</a>)}
    <a href={base+'contact/'}>{de?'Kontakt':'Contact'} ↗</a>
  </nav>
</details>


<style is:inline>
/* Inline delivery prevents a stale globally cached stylesheet from turning this dropdown into inline links. */
.main-navigation .nav-industries{position:relative;z-index:100;flex:none}
.main-navigation .nav-industries>summary{display:flex;align-items:center;gap:6px;cursor:pointer;list-style:none;font-size:13px;font-weight:650;padding:14px 0;white-space:nowrap}
.main-navigation .nav-industries>summary::-webkit-details-marker{display:none}
.main-navigation .nav-industries>summary:focus-visible{outline:2px solid #20b9b4;outline-offset:5px}
.main-navigation .nav-industries[open] .nav-services__chevron{transform:rotate(180deg)}
.main-navigation .nav-industries__menu{position:absolute;display:flex;flex-direction:column;top:100%;left:-25px;z-index:155;width:min(325px,calc(100vw - 30px));border:1px solid #d5e5ed;border-radius:9px;background:#fff;padding:9px;box-shadow:0 18px 48px #061c2b35;white-space:normal}
.main-navigation .nav-industries:not([open]) .nav-industries__menu{display:none}
.main-navigation .nav-industries__menu>a{display:block;padding:13px 12px;color:#153248!important;font-size:12px;line-height:1.4;border-radius:5px;text-decoration:none}
.main-navigation .nav-industries__menu>a:hover,.main-navigation .nav-industries__menu>a:focus-visible{background:#ebf6f8;color:#0b8187!important}
.main-navigation .nav-industries__menu>a+a{border-top:1px solid #eaf0f4}
.main-navigation .nav-industries__menu strong{display:block;font-size:13px}
.main-navigation .nav-industries__menu small{display:block;color:#6b8393;margin-top:5px;font-size:11px}
.main-navigation .nav-industries__menu .nav-industries__all{display:flex;align-items:center;justify-content:space-between;background:#e9f4f6;font-weight:850;color:#0b7080!important;margin-bottom:4px}
.site-header .main-navigation .nav-industries>summary:hover,.site-header .main-navigation .nav-industries[open]>summary{color:#62e2d8}

/* Current-page affordance shared by all three dropdowns and mobile navigation. */
.site-header .main-navigation details.is-current-section>summary{color:#62e2d8;font-weight:800}
.site-header .main-navigation .nav-products__menu>a.is-current,
.site-header .main-navigation .nav-services__menu>a.is-current,
.site-header .main-navigation .nav-industries__menu>a.is-current{
  background:#def8f4!important;color:#075f70!important;
  box-shadow:inset 3px 0 0 #11bdb1;
}
.site-header .main-navigation a.is-current:not(.nav-services__item){color:#075f70!important}
.site-header .main-navigation>a.is-current{color:#62e2d8!important;text-decoration:underline;text-underline-offset:6px}
.site-header .mobile-menu-panel a.is-current{
  background:#def8f4!important;color:#075f70!important;
  box-shadow:inset 3px 0 0 #11bdb1;font-weight:800;
}
.site-header .mobile-menu-panel details.is-current-section>summary{color:#075f70!important;font-weight:850!important}
</style>

<script>

  // Highlight the page being viewed, not the last item clicked.
  // This also works when a page is opened directly, refreshed, or shared.
  const currentPath = window.location.pathname.replace(/\/+$/, '') || '/';
  const currentHash = window.location.hash;
  document.querySelectorAll<HTMLAnchorElement>('.main-navigation a[href], .mobile-menu-panel a[href]').forEach((link) => {
    const target = new URL(link.href, window.location.href);
    if (target.origin !== window.location.origin) return;
    const targetPath = target.pathname.replace(/\/+$/, '') || '/';
    const isCurrent = targetPath === currentPath && (target.hash ? target.hash === currentHash : true);
    if (!isCurrent) return;
    link.classList.add('is-current');
    link.setAttribute('aria-current', 'page');
    link.closest('details')?.classList.add('is-current-section');
  });

  const category = [
    { selector: '.nav-products', test: /^\/(de|en)\/(products|openkubes|kubernautic)(\/|$)/ },
    { selector: '.nav-services', test: /^\/(de|en)\/(kubernauts-kubernetes-services|services)(\/|$)/ },
    { selector: '.nav-industries', test: /^\/(de|en)\/industries(\/|$)/ }
  ];
  category.forEach(({selector,test}) => {
    if (test.test(currentPath)) document.querySelectorAll(selector).forEach(el => el.classList.add('is-current-section'));
  });
  document.querySelectorAll<HTMLDetailsElement>('.nav-services, .nav-products, .nav-industries').forEach((menu) => {
    let openedByHover = false;
    menu.addEventListener('pointerenter', (event) => {
      if (event.pointerType === 'mouse' && window.matchMedia('(min-width: 1021px)').matches) {
        if (!menu.open) { menu.open = true; openedByHover = true; }
      }
    });
    menu.addEventListener('pointerleave', () => {
      if (openedByHover) { menu.open = false; openedByHover = false; }
    });
    menu.addEventListener('toggle', () => {
      if (!menu.open) openedByHover = false;
    });
    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        menu.open = false;
        openedByHover = false;
        menu.querySelector('summary')?.focus();
      }
    });
    document.addEventListener('pointerdown', (event) => {
      if (menu.open && !menu.contains(event.target as Node)) {
        menu.open = false;
        openedByHover = false;
      }
    });
  });
</script>
