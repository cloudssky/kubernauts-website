---
interface Props { lang:'de'|'en'; onHome?:boolean; }
const {lang,onHome=false}=Astro.props;
const de=lang==='de';
const base='/'+lang+'/';
const items=[
 {label:de?'Platform Engineering':'Platform Engineering',detail:de?'Architektur, GitOps & Automatisierung':'Architecture, GitOps & Automation',url:base+'#services',icon:'layers'},
 {label:de?'Enterprise Kubernetes Operations':'Enterprise Kubernetes Operations',detail:de?'Managed Kubernetes, SRE & Security':'Managed Kubernetes, SRE & Security',url:base+'kubernauts-kubernetes-services/index.html',icon:'activity'},
 {label:'AI & MLOps',detail:de?'Private AI & Modellbetrieb':'Private AI & Model Operations',url:base+'#services',icon:'brain'},
 {label:de?'24×7 Support & Managed Operations':'24×7 Support & Managed Operations',detail:de?'Support & Lifecycle Management':'Support & Lifecycle Management',url:base+'#services',icon:'shield'}
];
const nav=[
 {label:de?'Branchen':'Industries',href:base+'#industries'},
 {label:de?'Plattformen':'Platforms',href:base+'#platforms'},
 {label:de?'Vorgehen':'Approach',href:base+'#approach'}
];
---
<nav class="navigation main-navigation" aria-label={de?'Hauptnavigation':'Main navigation'}>
  <details class="nav-services">
    <summary>{de?'Leistungen':'Services'} <span class="nav-services__chevron" aria-hidden="true">⌄</span></summary>
    <div class="nav-services__menu">
      {items.map((item)=><a href={item.url} class="nav-services__item">
        <span class="nav-services__dot" aria-hidden="true"></span>
        <span><strong>{item.label}</strong><small>{item.detail}</small></span>
        <span aria-hidden="true">↗</span>
      </a>)}
      <a class="nav-services__all" href={base+'#services'}>{de?'Alle Leistungen':'All services'} <span aria-hidden="true">→</span></a>
    </div>
  </details>
  {nav.map(item=><a href={item.href}>{item.label}</a>)}
</nav>
<details class="mobile-menu">
  <summary aria-label={de?'Menü öffnen':'Open menu'}><span class="hamburger" aria-hidden="true">☰</span><span>{de?'Menü':'Menu'}</span></summary>
  <nav class="mobile-menu-panel" aria-label={de?'Mobile Navigation':'Mobile navigation'}>
    <details class="mobile-services">
      <summary>{de?'Leistungen':'Services'} <span aria-hidden="true">⌄</span></summary>
      <div class="mobile-services__links">
        {items.map(item=><a href={item.url}>{item.label}</a>)}
        <a href={base+'#services'}>{de?'Alle Leistungen':'All services'}</a>
      </div>
    </details>
    {nav.map(item=><a href={item.href}>{item.label}</a>)}
    <a href={base+'contact/'}>{de?'Kontakt':'Contact'} ↗</a>
  </nav>
</details>
