---
interface Props {lang:'de'|'en'}
const {lang}=Astro.props;
const d={"de":{"eyebrow":"PLATTFORMEN & PRODUKTINITIATIVEN","title":"Open engineering.","highlight":"Own your infrastructure.","intro":"Zwei eigenständige Plattformrichtungen, eine gemeinsame Engineering-DNA: souveräne Kubernetes-Infrastruktur mit OpenKubes und AI-native Operations mit Kubernautic.","flagship":"UNSERE PLATTFORMEN","openKubes":"Das offene Kubernetes-Plattform-Framework","okIntro":"OpenKubes definiert Architekturverträge, überprüfbare Governance und offene Bausteine für kontrollierbare Kubernetes-Plattformen über Rechenzentrum, Cloud und Edge hinweg.","okPill":["Contracts First","Evidence Driven","Sovereign by Design"],"okBtn":"OpenKubes entdecken","okSite":"Offizielle Projektwebsite","kIntro":"Kubernautic ist unsere eigenständige Initiative für AI-native Kubernetes Operations: Signale beobachten, Kontext analysieren und Aktionen innerhalb klarer menschlicher Freigabegrenzen steuern.","kPill":["Observe & Reason","Governed Operations","Human in Control"],"kBtn":"Kubernautic entdecken","kSite":"Offizielle Produktwebsite","cap":"SPEZIALISIERTE PLATTFORMFÄHIGKEITEN","capTitle":"Built for the real world.","capIntro":"Spezialisierte OpenKubes-Einsatzfelder – von souveräner Infrastruktur und Private AI bis zu industriellen Edge- und Robotics-Systemen.","detail":"Mehr erfahren","consult":"Projekt besprechen","status":"LÖSUNGSGEBIET · OPENKUBES","items":[{"id":"bare-metal","name":"Bare Metal & Virtualization","eyebrow":"01 / COMPUTE","desc":"Kubernetes und KubeVirt auf kontrollierter Infrastruktur. Cluster-Lifecycle, Storage, Networking und deklarative Bereitstellung für Enterprise-Workloads.","tags":["Bare Metal","KubeVirt","Cluster API"],"tone":"blue"},{"id":"edge","name":"Industrial Edge","eyebrow":"02 / DISTRIBUTED","desc":"Konsistente Plattform-Operations über Werke, Logistikstandorte und verteilte Edge-Umgebungen – mit GitOps und kontrollierbarem Lifecycle.","tags":["Edge Kubernetes","GitOps","Fleet Operations"],"tone":"teal"},{"id":"robotics","name":"Robotics & Physical AI","eyebrow":"03 / AUTONOMOUS","desc":"Offene Infrastruktur für Robotik-Flotten, ROS 2, verteilte Inferenz und intelligente industrielle Systeme. Von der Architektur zum einsatzfähigen Pilot.","tags":["ROS 2","Open-RMF","Physical AI"],"tone":"orange"},{"id":"private-ai","name":"Private AI & Inhouse AI","eyebrow":"04 / AI","desc":"KI-Workloads und Modellinferenz auf Kubernetes mit kontrolliertem Datenzugriff, GPU-Orchestrierung und nachvollziehbaren Betriebsprozessen.","tags":["Private LLMs","GPU","MLOps"],"tone":"green"},{"id":"security","name":"Security & Governance","eyebrow":"05 / TRUST","desc":"Plattform-Härtung, Identity & Access Management, Policy Enforcement und sichere Software-Lieferketten von Beginn an.","tags":["Zero Trust","Policies","Supply Chain"],"tone":"blue"},{"id":"agentic","name":"Agentic Platform Operations","eyebrow":"06 / INTELLIGENCE","desc":"Evidenzbasierte Diagnose, Agent Catalog und Operations Contracts als Grundlage für menschlich kontrollierte Automatisierung.","tags":["Diagnostics","Evidence","Approval"],"tone":"teal"}],"note":"Die dargestellten Bereiche beschreiben Plattformfähigkeiten und Produktinitiativen; die Verfügbarkeit einzelner Funktionen hängt vom jeweiligen Implementierungs- und Projektstand ab.","ctaHead":"Your infrastructure. Your terms.","ctaText":"Sprechen wir über ein OpenKubes-Pilotprojekt, Private AI, industrielle Plattformen oder den Einsatz von Kubernautic.","ctaBtn":"Technisches Gespräch vereinbaren"},"en":{"eyebrow":"PLATFORMS & PRODUCT INITIATIVES","title":"Open engineering.","highlight":"Own your infrastructure.","intro":"Two distinct platform directions, one engineering DNA: sovereign Kubernetes foundations with OpenKubes and AI-native operations with Kubernautic.","flagship":"OUR PLATFORMS","openKubes":"The open Kubernetes platform framework","okIntro":"OpenKubes defines architecture contracts, verifiable governance and open building blocks for controllable Kubernetes platforms across data centers, cloud and edge.","okPill":["Contracts First","Evidence Driven","Sovereign by Design"],"okBtn":"Explore OpenKubes","okSite":"Official project website","kIntro":"Kubernautic is our distinct initiative for AI-native Kubernetes operations: observe signals, reason over context and govern actions through clearly defined human approval.","kPill":["Observe & Reason","Governed Operations","Human in Control"],"kBtn":"Explore Kubernautic","kSite":"Official product website","cap":"SPECIALIZED PLATFORM CAPABILITIES","capTitle":"Built for the real world.","capIntro":"Specialized OpenKubes applications – from sovereign infrastructure and private AI to industrial edge and robotics.","detail":"Explore","consult":"Discuss a project","status":"SOLUTION AREA · OPENKUBES","items":[{"id":"bare-metal","name":"Bare Metal & Virtualization","eyebrow":"01 / COMPUTE","desc":"Kubernetes and KubeVirt on controlled infrastructure. Cluster lifecycle, storage, networking and declarative provisioning for enterprise workloads.","tags":["Bare Metal","KubeVirt","Cluster API"],"tone":"blue"},{"id":"edge","name":"Industrial Edge","eyebrow":"02 / DISTRIBUTED","desc":"Consistent platform operations across factories, warehouses and distributed edge environments using GitOps and controlled lifecycle processes.","tags":["Edge Kubernetes","GitOps","Fleet Operations"],"tone":"teal"},{"id":"robotics","name":"Robotics & Physical AI","eyebrow":"03 / AUTONOMOUS","desc":"Open infrastructure for robotic fleets, ROS 2, distributed inference and intelligent industrial systems – from architecture to practical pilots.","tags":["ROS 2","Open-RMF","Physical AI"],"tone":"orange"},{"id":"private-ai","name":"Private AI & Inhouse AI","eyebrow":"04 / AI","desc":"AI workloads and model inference on Kubernetes with controlled data access, GPU orchestration and accountable operations.","tags":["Private LLMs","GPU","MLOps"],"tone":"green"},{"id":"security","name":"Security & Governance","eyebrow":"05 / TRUST","desc":"Platform hardening, identity and access management, policy enforcement and secure software supply chains by design.","tags":["Zero Trust","Policies","Supply Chain"],"tone":"blue"},{"id":"agentic","name":"Agentic Platform Operations","eyebrow":"06 / INTELLIGENCE","desc":"Evidence-based diagnostics, agent catalog and operations contracts for human-governed automation.","tags":["Diagnostics","Evidence","Approval"],"tone":"teal"}],"note":"These solution areas describe platform capabilities and product initiatives. Individual features depend on the current implementation and project scope.","ctaHead":"Your infrastructure. Your terms.","ctaText":"Let's discuss an OpenKubes pilot, private AI, industrial platforms or a Kubernautic use case.","ctaBtn":"Book an engineering conversation"}}[lang];
const path='/'+lang+'/contact/';
---
<main class="products-main">
  <section class="products-hero">
    <div class="wrap products-hero__grid">
      <div>
        <p class="eyebrow">{d.eyebrow}</p>
        <h1>{d.title}<br/><em>{d.highlight}</em></h1>
        <p>{d.intro}</p>
        <a href="#products-flagships" class="products-hero__jump">{d.flagship} <span aria-hidden="true">↓</span></a>
      </div>
      <div class="products-hero__diagram" aria-hidden="true">
        <div class="products-hero__halo products-hero__halo--outer"></div>
        <div class="products-hero__halo products-hero__halo--inner"></div>
        <div class="products-hero__core"><img src="/brand/kubernauts-hexagon.svg" alt="" width="112" height="112"/></div>
        <span class="products-hero__orb products-hero__orb--a">OPENKUBES</span>
        <span class="products-hero__orb products-hero__orb--b">KUBERNAUTIC</span>
      </div>
    </div>
  </section>
  <section class="products-featured" id="products-flagships">
    <div class="wrap">
      <p class="eyebrow">{d.flagship}</p>
      <div class="products-featured__grid">
        <article class="products-featured__card products-featured__card--open">
          <div class="products-featured__visual"><span class="products-featured__mono">OK</span><span>OPEN · DECLARATIVE · SOVEREIGN</span></div>
          <div class="products-featured__body">
            <h2>Open<span class="products-featured__rainbow">Kubes</span><span class="products-featured__dot">.</span></h2>
            <h3>{d.openKubes}</h3><p>{d.okIntro}</p>
            <ul>{d.okPill.map(p=><li>{p}</li>)}</ul>
            <a class="products-featured__link" href="https://openkubes.org" target="_blank" rel="noopener noreferrer">{d.okBtn} ↗</a>
            <span class="products-featured__site">{d.okSite} · openkubes.org</span>
          </div>
        </article>
        <article class="products-featured__card products-featured__card--ai">
          <div class="products-featured__visual"><span class="products-featured__mono products-featured__mono--ai">K</span><span>OBSERVE · REASON · GOVERN</span></div>
          <div class="products-featured__body">
            <h2 class="products-featured__nautic">KUBER<span>NAUTIC</span>.</h2>
            <h3>Agentic AI for Kubernetes Operations</h3><p>{d.kIntro}</p>
            <ul>{d.kPill.map(p=><li>{p}</li>)}</ul>
            <a class="products-featured__link" href="https://kubernautic.com" target="_blank" rel="noopener noreferrer">{d.kBtn} ↗</a>
            <span class="products-featured__site">{d.kSite} · kubernautic.com</span>
          </div>
        </article>
      </div>
    </div>
  </section>
  <section id="products-solutions" class="products-capabilities">
    <div class="wrap">
      <div class="products-capabilities__heading"><div><p class="eyebrow">{d.cap}</p><h2>{d.capTitle}</h2></div><p>{d.capIntro}</p></div>
      <div class="products-capabilities__grid">
        {d.items.map(item=><article id={item.id} class={`products-capability products-capability--${item.tone}`}>
          <div class="products-capability__top"><span>{item.eyebrow}</span><span aria-hidden="true">⬡</span></div>
          <h3>{item.name}</h3><p>{item.desc}</p>
          <ul>{item.tags.map(tag=><li>{tag}</li>)}</ul>
          <a href={item.id==="private-ai" ? `/${lang}/openkubes/inhouse-ai/` : item.id==="edge" ? `/${lang}/openkubes/openkubes-edge/index.html` : ["bare-metal","robotics","security"].includes(item.id) ? `/${lang}/products/${item.id}/` : path}>{["bare-metal","robotics","security","private-ai","edge"].includes(item.id) ? d.detail : d.consult} ↗</a>
        </article>)}
      </div>
      <p class="products-capabilities__note">{d.note}</p>
    </div>
  </section>
  <section class="products-cta"><div class="wrap">
    <p class="eyebrow">ENGINEER · OPERATE · INNOVATE</p>
    <h2>{d.ctaHead}</h2><p>{d.ctaText}</p>
    <a href={path}>{d.ctaBtn} ↗</a>
  </div></section>
</main>
