---
interface Props {lang:'de'|'en'; product:'bare-metal'|'robotics'|'security'}
const {lang,product}=Astro.props;
const data={"bare-metal":{"de":{"eyebrow":"OPENKUBES · BARE METAL","title":"Eine Plattform für","accent":"Container, VMs und KI.","lead":"OpenKubes Bare Metal verbindet Kubernetes, KubeVirt und deklaratives Infrastrukturmanagement für leistungsfähige Enterprise-Workloads auf eigener Hardware.","problem":"Getrennte Infrastruktur. Unnötige Komplexität.","problemBody":"Kubernetes-Cluster, Virtualisierung, KI-Infrastruktur, CAD und IoT werden oft in getrennten Silos betrieben. Ein gemeinsamer Plattformansatz ermöglicht konsistentere Architektur, Governance und Betriebsprozesse.","sections":[["Kubernetes & KubeVirt","Container und virtuelle Maschinen auf einer Kubernetes-basierten Infrastruktur mit gemeinsamen Betriebs- und Governance-Prozessen."],["Cluster API & Crossplane","Deklarative Bereitstellung und Lifecycle-Management für Cluster und Infrastruktur über nachvollziehbare Schnittstellen."],["GPU & Engineering Workloads","Ressourcenpools für KI-Inferenz, Training sowie virtuelle CAD- und Engineering-Arbeitsplätze."],["Networking & Storage","Auslegung von Netzwerk, Load Balancing, persistentem Storage und Verfügbarkeit für anspruchsvolle Workloads."],["Security & Isolation","Namespace-, Cluster- oder infrastrukturbasierte Isolation je nach Schutzbedarf und Betriebsmodell."],["Day-2 Operations","Monitoring, Upgrades, Backup, Recovery und Policy Enforcement in einem abgestimmten Plattformmodell."]],"layers":["WORKLOADS · VMS · AI","KUBEVIRT · KUBERNETES","BARE METAL · GPU · STORAGE"],"cta":"Bare-Metal-Plattform besprechen","note":"Die Architektur wird pro Infrastrukturprovider und Workload-Anforderung validiert; insbesondere BMC-/Redfish-Zugriff ist nicht überall verfügbar."},"en":{"eyebrow":"OPENKUBES · BARE METAL","title":"One platform for","accent":"containers, VMs and AI.","lead":"OpenKubes Bare Metal brings Kubernetes, KubeVirt and declarative infrastructure management together for demanding enterprise workloads on controlled hardware.","problem":"Fragmented infrastructure. Unnecessary complexity.","problemBody":"Kubernetes, virtualization, AI, CAD and IoT often live in separate silos. A common platform architecture can bring consistent governance, automation and operations.","sections":[["Kubernetes & KubeVirt","Run containers and virtual machines on a Kubernetes-based foundation with aligned operational controls."],["Cluster API & Crossplane","Declarative provisioning and lifecycle management through reviewable infrastructure and cluster interfaces."],["GPU & Engineering Workloads","Resource pools for AI inference, training, and virtual CAD or engineering workstations."],["Networking & Storage","Network, load balancing, persistence and availability designed for enterprise workload requirements."],["Security & Isolation","Namespace, cluster or dedicated-infrastructure separation to match the protection needs of workloads."],["Day-2 Operations","Monitoring, upgrades, backup, recovery and policy enforcement in a coherent operating model."]],"layers":["WORKLOADS · VMS · AI","KUBEVIRT · KUBERNETES","BARE METAL · GPU · STORAGE"],"cta":"Discuss bare-metal architecture","note":"Architecture is validated per provider and workload; BMC/Redfish access is not universally available."}},"robotics":{"de":{"eyebrow":"OPENKUBES · ROBOTICS & PHYSICAL AI","title":"Intelligente Flotten.","accent":"Kontrollierte Infrastruktur.","lead":"Eine offene Plattformarchitektur für Robotik, ROS 2, Flottenmanagement und Edge AI – konzipiert für verteilte, sicherheitsbewusste industrielle Umgebungen.","problem":"Robotik braucht mehr als Roboter.","problemBody":"Autonome mobile Roboter, KI-Inferenz, Flottenkoordination und industrielle Systeme müssen über Netzwerke, Standorte und Sicherheitsgrenzen hinweg zusammenarbeiten. OpenKubes verbindet Infrastruktur und Operations mit offenen Integrationsmöglichkeiten.","sections":[["ROS 2 & Open-RMF","Integrationspfade für Robotik-Kommunikation, Flottenkoordination und interoperable Workflows."],["Fleet & Edge Operations","GitOps-gestützte Bereitstellung und Updates für verteilte Robotik- und Edge-Standorte."],["Physical AI & GPU","Infrastruktur für lokale Inferenz und KI-Workloads in industriellen Einsatzumgebungen."],["Enterprise Integration","Anbindung an WMS, MES, ERP, OT-Systeme und bestehende APIs nach projektspezifischen Anforderungen."],["Observability & Diagnostics","Monitoring von Plattform, Flottenzustand, Ereignissen und KI-Workloads mit nachvollziehbaren Betriebsdaten."],["Safety & Security Boundaries","Netzwerksegmentierung, Identitäten, Policies, Audit-Trails und explizite Freigabegrenzen für automatische Aktionen."]],"layers":["ROBOT FLEETS · ROS 2 · OPEN-RMF","EDGE AI · GITOPS · OPERATIONS","KUBERNETES · NETWORKING · SECURITY"],"cta":"Robotik-Pilotprojekt besprechen","note":"Robotics & Physical AI wird als Integrations- und Plattforminitiative entwickelt; Hardwarefreigaben, funktionale Sicherheit und Echtzeitanforderungen sind je Einsatzfall separat nachzuweisen."},"en":{"eyebrow":"OPENKUBES · ROBOTICS & PHYSICAL AI","title":"Intelligent fleets.","accent":"Governed infrastructure.","lead":"Open platform architecture for robotics, ROS 2, fleet management and edge AI, designed for distributed and security-conscious industrial environments.","problem":"Robotics needs more than robots.","problemBody":"Autonomous mobile robots, AI inference, fleet coordination and industrial systems have to work across networks, facilities and security boundaries. OpenKubes links infrastructure operations with open integration paths.","sections":[["ROS 2 & Open-RMF","Integration paths for robotic communication, fleet coordination and interoperable workflows."],["Fleet & Edge Operations","GitOps-based deployment and updates across distributed robotics and edge locations."],["Physical AI & GPU","Infrastructure for local inference and AI workloads in industrial environments."],["Enterprise Integration","Connect WMS, MES, ERP, OT and existing APIs according to project requirements."],["Observability & Diagnostics","Monitor platform, fleet status, events and AI workloads through traceable operational data."],["Safety & Security Boundaries","Segmentation, identity, policies, audit trails and explicit approval boundaries for automated actions."]],"layers":["ROBOT FLEETS · ROS 2 · OPEN-RMF","EDGE AI · GITOPS · OPERATIONS","KUBERNETES · NETWORKING · SECURITY"],"cta":"Discuss a robotics pilot","note":"Robotics and Physical AI is a platform integration initiative; hardware approval, functional safety and real-time requirements must be verified per use case."}},"security":{"de":{"eyebrow":"OPENKUBES · SECURITY & GOVERNANCE","title":"Security by design.","accent":"Governance by evidence.","lead":"Souveräne Kubernetes-Sicherheit vom Zugang zur Plattform über Netzwerk- und Supply-Chain-Policies bis zu überprüfbarem Day-2-Betrieb.","problem":"Security ist kein nachträgliches Add-on.","problemBody":"Identitäten, Infrastrukturgrenzen, Clusterkonfiguration, Artefakte und Betriebsabläufe müssen gemeinsam betrachtet werden. Wir setzen auf überprüfbare Sicherheitsanforderungen und versionierte Architekturentscheidungen.","sections":[["Identity & Access","OIDC/SSO, Keycloak-Integration, rollenbasierte Zugriffsmodelle und kontrollierter Zugriff auf Control Planes."],["Policy as Code","RBAC, Kyverno und OPA für deklarative Schutzregeln, Admission Control und nachvollziehbare Freigaben."],["Network & Zero Trust","Segmentierung mit Kubernetes NetworkPolicies sowie CNI-spezifische Sicherheitsmechanismen."],["Software Supply Chain","Image-Scanning, SBOMs, Signaturen und überprüfbare Build- und Delivery-Prozesse mit geeigneten Open-Source-Werkzeugen."],["Secrets & Runtime","Secrets Management, Runtime-Security, Audit-Logging und Erkennung auffälliger Plattformaktivität."],["Compliance & Evidence","CIS-orientierte Hardening-Checks, dokumentierte Ausnahmen, Nachweise und kontinuierliche Konfigurationsprüfung."]],"layers":["IDENTITY · POLICIES · AUDIT","SUPPLY CHAIN · RUNTIME · NETWORK","KUBERNETES · OPENKUBES · GOVERNANCE"],"cta":"Security-Architektur besprechen","note":"Security- und Compliance-Funktionen sind konfigurations- und betriebsabhängig. Eine Zertifizierung oder vollständige regulatorische Konformität wird nicht pauschal zugesichert."},"en":{"eyebrow":"OPENKUBES · SECURITY & GOVERNANCE","title":"Security by design.","accent":"Governance by evidence.","lead":"Sovereign Kubernetes security from identity and network boundaries to software supply chains and verifiable day-two operations.","problem":"Security is not an afterthought.","problemBody":"Identity, infrastructure boundaries, cluster configuration, artifacts and operational workflows must be designed as a coherent whole. We use reviewable requirements and versioned architecture decisions.","sections":[["Identity & Access","OIDC/SSO, Keycloak integration, role-based access and controlled access to control planes."],["Policy as Code","RBAC, Kyverno and OPA for declarative safeguards, admission control and reviewable approvals."],["Network & Zero Trust","Segmentation with Kubernetes NetworkPolicies and CNI-specific security controls."],["Software Supply Chain","Image scanning, SBOMs, signing and verifiable delivery pipelines using suitable open-source tooling."],["Secrets & Runtime","Secret management, runtime protection, audit logging and detection of suspicious platform activity."],["Compliance & Evidence","CIS-oriented hardening checks, documented exceptions, evidence and continuous configuration verification."]],"layers":["IDENTITY · POLICIES · AUDIT","SUPPLY CHAIN · RUNTIME · NETWORK","KUBERNETES · OPENKUBES · GOVERNANCE"],"cta":"Discuss security architecture","note":"Security and compliance capabilities depend on configuration and operations; no blanket certification or regulatory compliance claim is made."}}};
const d=data[product][lang];
const contact='/'+lang+'/contact/';
const booking='https://calendly.com/kubernauts/30min';
---
<main class={`product-detail product-detail--${product}`}>
  <section class="product-detail__hero"><div class="wrap product-detail__hero-grid">
    <div>
      <p class="eyebrow">{d.eyebrow}</p>
      <h1>{d.title}<br/><em>{d.accent}</em></h1>
      <p class="product-detail__lead">{d.lead}</p>
      <div class="product-detail__actions">
        <a class="product-detail__primary" href={booking} target="_blank" rel="noopener noreferrer">{d.cta} ↗</a>
        <a class="product-detail__secondary" href={contact}>{lang==='de'?'Kontaktseite':'Contact page'} ↗</a>
      </div>
    </div>
    <div class="product-detail__visual" aria-label="OpenKubes technology layers">
      <span class="product-detail__visual-header">OPENKUBES / {product.toUpperCase()}</span>
      <div class="product-detail__layer-stack">{d.layers.map((layer,i)=><div class={`product-detail__layer product-detail__layer--${i}`}>{layer}</div>)}</div>
      <span class="product-detail__visual-footer">CONTRACTS FIRST · HUMAN GOVERNED</span>
    </div>
  </div></section>
  <section class="product-detail__problem"><div class="wrap product-detail__problem-grid">
    <div><p class="eyebrow">THE CHALLENGE</p><h2>{d.problem}</h2></div><p>{d.problemBody}</p>
  </div></section>
  <section class="product-detail__capabilities"><div class="wrap">
    <p class="eyebrow">OPENKUBES / CAPABILITIES</p>
    <h2>{lang==='de'?'Architektur und Fähigkeiten.':'Architecture and capabilities.'}</h2>
    <div class="product-detail__cards">{d.sections.map(([heading,description],i)=><article>
      <span>{String(i+1).padStart(2,'0')} / CAPABILITY</span>
      <h3>{heading}</h3><p>{description}</p>
    </article>)}</div>
    <p class="product-detail__disclaimer">{d.note}</p>
  </div></section>
  <section class="product-detail__closing"><div class="wrap">
    <p class="eyebrow">LET'S TALK ENGINEERING</p>
    <h2>{lang==='de'?'Ihre Plattform. Ihre Anforderungen.':'Your platform. Your requirements.'}</h2>
    <p>{lang==='de'?'Wir besprechen Architektur, Einsatzbedingungen und einen realistischen Pilotumfang gemeinsam mit Ihrem Team.':'Let us discuss architecture, deployment constraints and a realistic pilot scope with your team.'}</p>
    <div class="product-detail__actions"><a class="product-detail__primary" href={booking} target="_blank" rel="noopener noreferrer">{d.cta} ↗</a><a class="product-detail__secondary" href={'/'+lang+'/products/'}>{lang==='de'?'Alle Produkte':'All products'} ↗</a></div>
  </div></section>
</main>
