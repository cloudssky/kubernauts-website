---
interface Props { lang:'de'|'en'; role?:'sre'|'kam'; }
const {lang,role}=Astro.props;
const de=lang==='de';
const jobData={"sre":{"title":"SRE Solution Architect (f/m/d)","intro":["Bei Kubernauts werden aus großartigen Ideen schnell innovative Lösungen für Menschen. Leidenschaft für Technologie und Begeisterung für Open Source prägen unsere tägliche Arbeit — und es gibt kaum Grenzen für das, was du gemeinsam mit uns erreichen kannst.","Wir arbeiten mit einigen der angesehensten Unternehmen und innovativsten Engineering-Teams der Branche zusammen, um moderne Open-Source- und Cloud-Native-Technologien zu entwickeln.","Teil von Kubernauts zu werden bedeutet auch, aktiv in Open-Source-Communities mitzuwirken. Wir organisieren weltweit Community-Events über unsere Meetups und möchten den gesamten Weg gemeinsam mit dir gestalten."],"tasks":["Architektur, Design und Weiterentwicklung hochverfügbarer Kubernetes- und Cloud-Native-Plattformen","Entwicklung skalierbarer SRE- und Platform-Engineering-Konzepte für Enterprise-Kunden","Sicherstellung von Reliability, Performance, Security und Observability moderner Produktionsumgebungen","Aufbau und Optimierung von Monitoring-, Logging- und Alerting-Systemen","Entwicklung von Disaster-Recovery- und High-Availability-Strategien","Automatisierung von Infrastruktur- und Betriebsprozessen mit Infrastructure as Code und GitOps","Unterstützung von Kunden bei komplexen Cloud-, Kubernetes- und AI-Infrastrukturprojekten","Durchführung technischer Workshops, Architektur-Reviews und Solution-Designs","Zusammenarbeit mit internationalen Engineering-Teams und Kunden","Bereitschaft zu gelegentlichen Geschäftsreisen"],"requirements":["Mehrjährige Erfahrung im Bereich Site Reliability Engineering (SRE), Platform Engineering oder Cloud Architecture","Sehr gute Kenntnisse in Kubernetes und Cloud-Native-Technologien","Erfahrung mit High-Availability- und Distributed-System-Architekturen","Kenntnisse in Infrastructure as Code und Automatisierungstools wie Terraform, Ansible, Helm, ArgoCD und Flux","Erfahrung mit Observability-Stacks wie Prometheus, Grafana, OpenSearch, Loki und Jaeger","Erfahrung mit CI/CD-, GitOps- und DevOps-Praktiken","Gute Linux-, Netzwerk- und Security-Kenntnisse","Verständnis moderner Zero-Trust- und Security-by-Design-Konzepte","Strukturierte, lösungsorientierte und eigenständige Arbeitsweise","Sehr gute Englischkenntnisse; Deutsch ist von Vorteil"],"benefits":["Arbeit mit modernsten Technologien rund um Kubernetes, AI, Cloud und Edge Infrastructure","Flexible Arbeitszeiten und eine Remote-First-Kultur","Spannende Enterprise-Projekte mit hoher technischer Verantwortung","Direkten Einfluss auf Architekturentscheidungen und Plattformstrategien","Mitarbeit an innovativen Open-Source- und Cloud-Native-Projekten","Zusammenarbeit mit einem hochqualifizierten und leidenschaftlichen Tech-Team","Internationale Meetups, Community-Events und Konferenzen","Attraktive Vergütung und langfristige Entwicklungsmöglichkeiten"]},"kam":{"title":"Key Account Manager (f/m/d) – Cloud & Kubernetes Services","intro":["Bei Kubernauts sind wir spezialisiert auf Cloud-Native-Technologien, Kubernetes, KI-Integration und moderne IT-Architekturen.","Mit unserem Produkt OpenKubes bieten wir Unternehmen eine Plattform für automatisierte Cloud-, Container- und KI-Implementierungen — On-Premises oder in der Cloud. Unsere Kunden sind Enterprise-Unternehmen mit höchsten Anforderungen an Verfügbarkeit, Sicherheit und Performance."],"tasks":["Strategischer und operativer Vertrieb von Cloud-, Kubernetes- und KI-Services (Consulting, Implementierung und Managed Services)","Betreuung und Ausbau bestehender Key Accounts","Identifikation neuer Geschäftsmöglichkeiten und Aufbau langfristiger Kundenbeziehungen","Erstellung von Angeboten, Durchführung von Verhandlungen und erfolgreicher Vertragsabschluss","Enge Zusammenarbeit mit dem technischen Team zur Entwicklung maßgeschneiderter Lösungen","Repräsentation des Unternehmens auf Branchenveranstaltungen, Webinaren und Konferenzen"],"requirements":["Mehrjährige Erfahrung im B2B-Vertrieb, idealerweise im IT-, Cloud- oder Kubernetes-Umfeld","Fundiertes technisches Verständnis von Cloud-Technologien, Kubernetes, DevOps oder Containerisierung","Ausgeprägte Kommunikations- und Analysefähigkeiten","Hohe Eigenmotivation, Ergebnisorientierung und Kundenfokus","Fließende Englischkenntnisse; Deutsch ist ein großes Plus"],"benefits":["Arbeit mit modernsten Technologien (Kubernetes, KI, Cloud, Quantum Integration)","Flexible Arbeitszeiten und eine Remote-First-Kultur","Attraktive Vergütung mit leistungsbezogenen Komponenten","Direkten Einfluss auf Unternehmenswachstum und Kundenstrategie","Zusammenarbeit mit einem hochqualifizierten und leidenschaftlichen Tech-Team"]}};
const jobs=Object.entries(jobData).map(([id,job])=>({id,...job,slug:id==='sre'?'sre-solution-architect':'keyaccount-manager'}));
const selected=role?jobs.find(j=>j.id===role):null;
const l=de?{eyebrow:'KARRIERE BEI KUBERNAUTS',title:'Gemeinsam',accent:'Zukunft gestalten.',intro:'Open Source, Cloud Native und Enterprise Engineering — mit Menschen, die Technologien gestalten und Verantwortung übernehmen.',open:'OFFENE POSITIONEN',tasks:'Deine Aufgaben',requirements:'Dein Profil',benefits:'Was wir bieten',apply:'Jetzt bewerben',introJob:'Über uns',how:'How To Apply',reach:'Interesse geweckt? Dann kontaktiere uns!',questions:'Erste Fragen beantwortet dir gerne Frau Anja Daniels unter',back:'Alle Stellenangebote',view:'Stelle ansehen'}:{eyebrow:'CAREERS AT KUBERNAUTS',title:'Engineer',accent:'what comes next.',intro:'Open source, cloud native and enterprise engineering — built by people who take ownership.',open:'OPEN POSITIONS',tasks:'Your responsibilities',requirements:'Your profile',benefits:'What we offer',apply:'Apply now',introJob:'About us',how:'How To Apply',reach:'Interested? Get in touch!',questions:'For initial questions, contact Anja Daniels at',back:'All career opportunities',view:'Full posting (German)'};
---
<main class="career-page">
  <section class="career-hero"><div class="wrap"><p class="eyebrow">{l.eyebrow}</p>{selected?<><a class="career-back" href={'/'+lang+'/careers/'}>← {l.back}</a><h1>{selected.title}</h1></>:<><h1>{l.title}<br/><em>{l.accent}</em></h1><p class="career-intro">{l.intro}</p></>}</div></section>
  {selected?<section class="career-content"><div class="wrap career-content__grid"><article class="career-description"><h2>{l.introJob}</h2>{selected.intro.map(p=><p>{p}</p>)}{[[l.tasks,selected.tasks],[l.requirements,selected.requirements],[l.benefits,selected.benefits]].map(([heading,items])=><section><h2>{heading}</h2><ul>{items.map(item=><li>{item}</li>)}</ul></section>)}</article><aside class="career-apply"><p class="eyebrow">{l.how}</p><h2>{l.reach}</h2><a class="career-apply__button" href={'mailto:careers@kubernauts.de?subject='+encodeURIComponent('Bewerbung: '+selected.title)}>{l.apply} ↗</a><p><a href="mailto:careers@kubernauts.de">careers@kubernauts.de</a></p><p>{l.questions}<br/><a href="tel:+4922137990680">+49 221 379 90 680</a></p></aside></div></section>:<section class="career-content"><div class="wrap"><p class="eyebrow">{l.open}</p><div class="career-list">{jobs.map((job,i)=><article class="career-list__item"><span>0{i+1} / KUBERNAUTS</span><h2>{job.title}</h2><p>{job.id==='sre'?'Kubernetes · Reliability · Architecture · GitOps':'Enterprise Sales · Cloud · Kubernetes · AI'}</p><a href={'/'+(de?'de':'de')+'/careers/'+job.slug+'/'}>{l.view} ↗</a></article>)}</div></div></section>}
</main>
